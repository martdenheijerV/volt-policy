# EU-pure database — self-hosted Postgres 17 on Hetzner (Germany).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# OIDC — Volt Auth (Authentik / Keycloak), German project, EU-hosted.
OIDC_ISSUER_URL=https://auth.volteuropa.org/realms/volt
OIDC_CLIENT_ID=volt-policy
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_SCOPE=openid profile email

# Session cookie — generate the secret with `openssl rand -base64 32`.
COOKIE_SECRET=
COOKIE_NAME=volt_session

# EU AI provider (Mistral, France) — optional, drafting falls back to stub without it
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Translation (DeepL, Germany) — optional
DEEPL_API_KEY=

# Self-hosted LanguageTool (German project) — Docker on the same VPS
LANGUAGETOOL_URL=http://languagetool:8010/v2/check

# SCIM provisioning — set to enable Volt Auth user sync
SCIM_TOKEN=

# Real-time collaboration websocket (HocusPocus on the VPS)
NEXT_PUBLIC_HOCUSPOCUS_URL=wss://realtime.policy.volteuropa.org
