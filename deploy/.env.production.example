# Production env file — copy to .env.production at repo root before docker compose up.
# All values must use the self-hosted EU URLs. ZERO US-incorporated dependencies.

# Postgres 17 (self-hosted on the same Hetzner VPS, German)
DATABASE_URL=postgres://postgres:<pwd>@host.docker.internal:5432/postgres

# OIDC — Volt Auth (Authentik / Keycloak) on the same VPS or central Volt Auth.
OIDC_ISSUER_URL=https://auth.policy.volteuropa.org/application/o/volt-policy/
OIDC_CLIENT_ID=volt-policy
OIDC_CLIENT_SECRET=<from_authentik_oauth_provider>
OIDC_REDIRECT_URI=https://policy.volteuropa.org/api/auth/callback
OIDC_SCOPE=openid profile email

# Session cookie. Generate with `openssl rand -base64 32`.
COOKIE_SECRET=<base64_32_random_bytes>
COOKIE_NAME=volt_session

# Mistral AI (France) — drafting
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# DeepL (Germany) — translation
DEEPL_API_KEY=

# LanguageTool (self-hosted in same compose)
LANGUAGETOOL_URL=http://languagetool:8010/v2/check

# HocusPocus realtime (same compose)
NEXT_PUBLIC_HOCUSPOCUS_URL=wss://realtime.policy.volteuropa.org
HOCUS_SECRET=<random_long_string>

# SCIM provisioning (set in Volt Auth as the bearer for SCIM PUSH)
SCIM_TOKEN=<random_long_string>
